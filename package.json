{
  "name": "dsh-soul-evolve",
  "version": "1.2.0",
  "description": "人格状态与缓慢演化插件：反射弧驱动的状态层 + 场景切面 + 带权重预算的演化条目",
  "license": "MIT",
  "author": "xiachuyoufeng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiachuyoufeng/dsh-soul-evolve.git"
  },
  "homepage": "https://github.com/xiachuyoufeng/dsh-soul-evolve#readme",
  "bugs": {
    "url": "https://github.com/xiachuyoufeng/dsh-soul-evolve/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./state": "./src/state.js",
    "./reflex": "./src/reflex.js",
    "./scene": "./src/scene.js",
    "./trace": "./src/trace.js",
    "./evolve": "./src/evolve.js",
    "./adapter": "./src/adapter.js",
    "./upgrade": "./src/upgrade.js",
    "./api": "./src/api.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "templates"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "persona",
    "soul",
    "memory",
    "llm"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/soul.test.js test/pattern.test.js",
    "verify": "node scripts/verify-plugin.mjs"
  }
}
